@using static UsuarioController
@model UserEditViewModel

@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Editar Usuário</h2>

    <div class="card shadow-sm p-4 mx-auto" style="max-width: 600px;">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="UserId" />

            <div class="form-group">
                <label for="UserName">Nome de Usuário</label>
                <input asp-for="UserName" class="form-control" />
            </div>

            <div class="form-group">
                <label for="Email">Email</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label>Perfis (Roles)</label>
                <div>
                    @foreach (var role in Model.AllRoles)
                    {
                        
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input"
                                name="SelectedRoles"
                                value="@role.Name"      
                                @if (role.Name is not null && Model.CurrentRoles.Contains(role.Name))
                                {
                                    <text>checked</text>
                                } 
                            />
                            <label class="form-check-label">@role.Name</label>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>
