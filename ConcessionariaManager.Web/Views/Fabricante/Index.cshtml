@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ConcessionariaManager.Core.Models.Fabricante>

@{
    ViewData["Title"] = "Fabricantes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Fabricantes</h1>
    <a asp-action="Create" class="btn btn-primary">
        + Adicionar Novo Fabricante
    </a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewData["searchString"]" class="form-control" placeholder="Buscar por nome..." />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary w-50">Pesquisar</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-50">Limpar</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Nome)</th>
                <th>@Html.DisplayNameFor(model => model.First().PaisOrigem)</th>
                <th>@Html.DisplayNameFor(model => model.First().AnoFundacao)</th>
                <th>@Html.DisplayNameFor(model => model.First().Website)</th>
                <th>@Html.DisplayNameFor(model => model.First().CreatedAt)</th>
                <th>@Html.DisplayNameFor(model => model.First().UpdatedAt)</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.PaisOrigem)</td>
                    <td>@Html.DisplayFor(modelItem => item.AnoFundacao)</td>
                    <td>
                        <a href="@item.Website" target="_blank" class="text-decoration-none">@item.Website</a>
                    </td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>@item.UpdatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning m-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info m-1">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger m-1">Excluir</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new
            {
                page,
                searchString = ViewData["searchString"]
            }), new PagedListRenderOptions
       {
           UlElementClasses = new[] { "pagination" },
           LiElementClasses = new[] { "page-item" },
           PageClasses = new[] { "page-link" },
           ActiveLiElementClass = "active",
           
       })
    </div>

</div>
