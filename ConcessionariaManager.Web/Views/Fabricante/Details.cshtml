@model ConcessionariaManager.Core.Models.Fabricante

@{
    ViewData["Title"] = "Detalhes do Fabricante";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Detalhes do Fabricante</h2>

    <div class="card shadow-sm p-4 mx-auto" style="max-width: 600px;">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Nome)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Nome)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.PaisOrigem)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.PaisOrigem)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.AnoFundacao)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.AnoFundacao)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Website)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Website)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CreatedAt)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.UpdatedAt)</dd>
        </dl>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        </div>
    </div>
</div>
