@model ConcessionariaManager.Core.Models.Fabricante

@{
    ViewData["Title"] = "Cadastrar Fabricante";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Cadastrar Fabricante</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Create" class="card shadow-sm p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PaisOrigem" class="form-label"></label>
                    <input asp-for="PaisOrigem" class="form-control" />
                    <span asp-validation-for="PaisOrigem" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AnoFundacao" class="form-label"></label>
                    <input asp-for="AnoFundacao" class="form-control" />
                    <span asp-validation-for="AnoFundacao" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Website" class="form-label"></label>
                    <input asp-for="Website" class="form-control" />
                    <span asp-validation-for="Website" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
