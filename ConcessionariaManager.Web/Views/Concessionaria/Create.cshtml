@model ConcessionariaManager.Core.Models.Concessionaria

@{
    ViewData["Title"] = "Cadastrar Concessionária";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Cadastrar Concessionária</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Create" class="card shadow-sm p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Telefone" class="form-label"></label>
                    <input asp-for="Telefone" class="form-control" id="telefone" />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="CapacidadeMaximaDeVeiculos" class="form-label"></label>
                    <input asp-for="CapacidadeMaximaDeVeiculos" class="form-control" />
                    <span asp-validation-for="CapacidadeMaximaDeVeiculos" class="text-danger"></span>
                </div>

                <h4 class="mt-4">Endereço</h4>
                <div class="form-group mb-3">
                    <label asp-for="Endereco.CEP" class="form-label"></label>
                    <input asp-for="Endereco.CEP" class="form-control" id="cep" />
                    <span asp-validation-for="Endereco.CEP" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Endereco.Rua" class="form-label"></label>
                    <input asp-for="Endereco.Rua" class="form-control" id="logradouro" disabled />
                    <span asp-validation-for="Endereco.Rua" class="text-danger"></span>
                    <input type="hidden" id="logradouro_hidden" name="Endereco.Rua" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Endereco.Bairro" class="form-label"></label>
                    <input asp-for="Endereco.Bairro" class="form-control" id="bairro" disabled />
                    <span asp-validation-for="Endereco.Bairro" class="text-danger"></span>
                    <input type="hidden" id="bairro_hidden" name="Endereco.Bairro" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Endereco.Cidade" class="form-label"></label>
                    <input asp-for="Endereco.Cidade" class="form-control" id="localidade" disabled />
                    <span asp-validation-for="Endereco.Cidade" class="text-danger"></span>
                    <input type="hidden" id="localidade_hidden" name="Endereco.Cidade" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Endereco.Estado" class="form-label"></label>
                    <input asp-for="Endereco.Estado" class="form-control" id="uf" disabled />
                    <span asp-validation-for="Endereco.Estado" class="text-danger"></span>
                    <input type="hidden" id="uf_hidden" name="Endereco.Estado" />
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Endereco.Numero" class="form-label"></label>
                    <input asp-for="Endereco.Numero" class="form-control" id="numero" />
                    <span asp-validation-for="Endereco.Numero" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Endereco.Complemento" class="form-label"></label>
                    <input asp-for="Endereco.Complemento" class="form-control" id="complemento" />
                    <span asp-validation-for="Endereco.Complemento" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}