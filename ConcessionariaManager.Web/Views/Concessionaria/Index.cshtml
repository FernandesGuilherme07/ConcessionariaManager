@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ConcessionariaManager.Core.Models.Concessionaria>

@{
    ViewData["Title"] = "Concessionarias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Concessionárias</h1>
    <a asp-action="Create" class="btn btn-primary">
        + Cadastrar Nova Concessionária
    </a>
</div>

<!-- Filtros -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <input type="text" name="nome" value="@ViewData["nome"]" class="form-control" placeholder="Buscar por nome..." />
        </div>
        <div class="col-md-3">
            <input type="text" name="localizacao" value="@ViewData["localizacao"]" class="form-control" placeholder="Buscar por endereço..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary w-50">Pesquisar</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-50">Limpar</a>
        </div>
    </div>
</form>

<!-- Tabela de Concessionárias -->
<div class="table-responsive">
    <table class="table table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Nome)</th>
                <th>@Html.DisplayNameFor(model => model.First().Telefone)</th>
                <th>@Html.DisplayNameFor(model => model.First().Email)</th>
                <th>@Html.DisplayNameFor(model => model.First().CapacidadeMaximaDeVeiculos)</th>
                <th>@Html.DisplayNameFor(model => model.First().CreatedAt)</th>
                <th>@Html.DisplayNameFor(model => model.First().UpdatedAt)</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.CapacidadeMaximaDeVeiculos)</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>@item.UpdatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning m-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info m-1">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger m-1">Excluir</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new
            {
                page,
                sortOrder = ViewData["CurrentSort"],
                nome = ViewData["nome"],
                localizacao = ViewData["localizacao"]
            }), new PagedListRenderOptions
   {
       UlElementClasses = new[] { "pagination" },
       LiElementClasses = new[] { "page-item" },
       PageClasses = new[] { "page-link" },
       ActiveLiElementClass = "active",
   })

    </div>


</div>