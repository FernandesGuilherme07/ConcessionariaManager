@model Venda

@{
    ViewData["Title"] = "Detalhes da Venda";
}

<h1 class="h3">Detalhes da Venda</h1>

<div class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <strong>Modelo do Veículo:</strong> @Model.Veiculo?.Modelo
        </div>
        <div class="col-md-6">
            <strong>Fabricante:</strong> @Model.Veiculo?.Fabricante?.Nome
        </div>
        <div class="col-md-6">
            <strong>Ano de Fabricação:</strong> @Model.Veiculo?.AnoFabricacao
        </div>
        <div class="col-md-6">
            <strong>Placa do Veículo:</strong> @Model.Veiculo?.Placa
        </div>
        <div class="col-md-6">
            <strong>Preço do Veículo:</strong> @Model.Veiculo?.Preco.ToString("C")
        </div>
        <div class="col-md-6">
            <strong>Tipo do Veículo:</strong> @Model.Veiculo?.TipoVeiculo.ToString()
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <strong>Nome do Cliente:</strong> @Model.NomeCliente
        </div>
        <div class="col-md-6">
            <strong>CPF do Cliente:</strong> @Model.CPFCliente
        </div>
        <div class="col-md-6">
            <strong>Telefone do Cliente:</strong> @Model.TelefoneCliente
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <strong>Concessionária:</strong> @Model.Concessionaria?.Nome
        </div>
        <div class="col-md-6">
            <strong>Endereço da Concessionária:</strong> @Model.Concessionaria?.Endereco.EnderecoCompleto
        </div>
        <div class="col-md-6">
            <strong>Telefone da Concessionária:</strong> @Model.Concessionaria?.Telefone
        </div>
        <div class="col-md-6">
            <strong>Email da Concessionária:</strong> @Model.Concessionaria?.Email
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <strong>Data da Venda:</strong> @Model.DataVenda.ToString("dd/MM/yyyy")
        </div>
        <div class="col-md-6">
            <strong>Preço da Venda:</strong> @Model.PrecoVenda.ToString("C")
        </div>
        <div class="col-md-6">
            <strong>Protocolo de Venda:</strong> @Model.ProtocoloVenda
        </div>
        <div class="col-md-6">
            <strong>Status da Venda:</strong> @(Model.Cancelada ? "Cancelada" : "Ativa")
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    @if (!Model.Cancelada)
    {
        <a asp-action="Cancelar" asp-route-id="@Model.Id" class="btn btn-danger">Cancelar Venda</a>
    }
    else
    {
        <span class="badge bg-secondary">Venda Cancelada</span>
    }
</div>
