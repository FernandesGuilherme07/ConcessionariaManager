
@using ConcessionariaManager.Web.Helpers
@using X.PagedList
@using X.PagedList.Mvc.Core


@model IPagedList<Venda>

@{
    ViewData["Title"] = "Vendas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Vendas</h1>
    <a asp-action="Create" class="btn btn-primary">
        + Criar Nova Venda
    </a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <input type="text" name="modelo" value="@ViewData["modelo"]" class="form-control" placeholder="Buscar por modelo..." />
        </div>
        <div class="col-md-3">
            <input type="text" name="cliente" value="@ViewData["cliente"]" class="form-control" placeholder="Buscar por cliente..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary w-50">Pesquisar</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-50">Limpar</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Veículo</th>
                <th>Cliente</th>
                <th>Concessionária</th>
                <th>Preço</th>
                <th>Data da venda</th>
                <th>Situação</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venda in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => venda.Veiculo!.Modelo)</td>
                    <td>@Html.DisplayFor(modelItem => venda.NomeCliente)</td>
                    <td>@Html.DisplayFor(modelItem => venda.Concessionaria!.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => venda.PrecoVenda)</td>
                    <td>@(venda.Cancelada ? "Cancelada" : "Concluída")</td>
                    <td>@venda.DataVenda.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a asp-action="Details" asp-route-id="@venda.Id" class="btn btn-sm btn-info m-1">Detalhes</a>
                            <a asp-action="Cancelar" asp-route-id="@venda.Id" class="btn btn-sm btn-danger m-1">Cancelar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-center">
    @Html.PagedListPager(Model, page => Url.Action("Index", new
        {
            page,
            sortOrder = ViewData["CurrentSort"],
            nome = ViewData["nome"],
            localizacao = ViewData["localizacao"]
        }), new PagedListRenderOptions
{
    UlElementClasses = new[] { "pagination" },
    LiElementClasses = new[] { "page-item" },
    PageClasses = new[] { "page-link" },
    ActiveLiElementClass = "active",
})

</div>
