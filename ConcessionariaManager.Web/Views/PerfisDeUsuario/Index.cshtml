@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Detalhes do Usuário";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Detalhes do Usuário</h2>

    <div class="card shadow-sm p-4 mx-auto" style="max-width: 600px;">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-4">Senha</dt>
            <dd class="col-sm-8">******</dd> <!-- Exibe senha mascarada -->

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.UserName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.UserName)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.PhoneNumber)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.PhoneNumber)</dd>
        </dl>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        </div>
    </div>
</div>
