@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ConcessionariaManager.Core.Models.Veiculo>

@{
    ViewData["Title"] = "Veículos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Veículos</h1>
    <a asp-action="Create" class="btn btn-primary">
        + Cadastrar Novo Veículo
    </a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewData["searchString"]" class="form-control" placeholder="Buscar por modelo..." />
        </div>
        <div class="col-md-2">
            <select name="tipoVeiculo" class="form-select">
                <option value="">Todos os Tipos</option>
                bool isSelected = ViewData["fabricanteId"]?.ToString() == fabricante.Id.ToString();
                <option value="Carro" >Carro</option>
                <option value="Moto">Moto</option>
                <option value="Caminhao">Caminhão</option>

            </select>
        </div>
        <div class="col-md-2">
            <select name="fabricanteId" class="form-select">
                <option value="">Todos os Fabricantes</option>

                @if (ViewBag.Fabricantes is List<ConcessionariaManager.Core.Models.Fabricante> fabricantes)
                {
                    foreach (var fabricante in fabricantes)
                    {
                        bool isSelected = ViewData["fabricanteId"]?.ToString() == fabricante.Id.ToString();
                        <option value="@fabricante.Id" selected="@(isSelected)"> @fabricante.Nome</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" name="anoFabricacao" value="@ViewData["anoFabricacao"]" class="form-control" placeholder="Ano Fabricação" />
        </div>
        <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary w-50">Pesquisar</button>
        <a asp-action="Index" class="btn btn-outline-secondary w-50">Limpar</a>
    </div>
    </div>
</form>


<div class="table-responsive">
    <table class="table table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Modelo)</th>
                <th>@Html.DisplayNameFor(model => model.First().AnoFabricacao)</th>
                <th>@Html.DisplayNameFor(model => model.First().Preco)</th>
                <th>Situação</th>
                <th>@Html.DisplayNameFor(model => model.First().TipoVeiculo)</th>
                <th>@Html.DisplayNameFor(model => model.First().Fabricante)</th>
                <th>@Html.DisplayNameFor(model => model.First().CreatedAt)</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                    <td>@Html.DisplayFor(modelItem => item.AnoFabricacao)</td>
                    <td>@item.Preco.ToString("C")</td>
                    <td>@(item.Vendido ? "Vendido" : "Disponível")</td>
                    <td>@Html.DisplayFor(modelItem => item.TipoVeiculo)</td>
                    <td>@item.Fabricante?.Nome</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning m-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info m-1">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger m-1">Excluir</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new
            {
                page,
                searchString = ViewData["searchString"]
            }), new PagedListRenderOptions
   {
       UlElementClasses = new[] { "pagination" },
       LiElementClasses = new[] { "page-item" },
       PageClasses = new[] { "page-link" },
       ActiveLiElementClass = "active",
   })
    </div>

</div>
