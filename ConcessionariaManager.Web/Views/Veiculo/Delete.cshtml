@model ConcessionariaManager.Core.Models.Veiculo

@{
    ViewData["Title"] = "Excluir Veículo";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Excluir Veículo</h2>

    <div class="card shadow-sm p-4 mx-auto" style="max-width: 600px;">
        <h5 class="text-danger mb-4 text-center">Tem certeza que deseja excluir este veículo?</h5>

        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Modelo)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Modelo)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.AnoFabricacao)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.AnoFabricacao)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Placa)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Placa)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Preco)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Preco)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TipoVeiculo)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.TipoVeiculo)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Fabricante.Nome)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Fabricante.Nome)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Descricao)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Descricao)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CreatedAt)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.UpdatedAt)</dd>
        </dl>

        <form asp-action="Delete" class="mt-4 d-flex justify-content-between">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
