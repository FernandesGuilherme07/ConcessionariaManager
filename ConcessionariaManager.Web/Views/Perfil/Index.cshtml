@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>

<h2>Perfis</h2>

<a asp-action="Create">Criar Novo perfil</a>

<table>
    <tr>
        <th>Nome</th>
        <th>Ações</th>
    </tr>
    @foreach (var role in Model)
    {
        <tr>
            <td>@role.Name</td>
            <td>
                <a asp-action="Delete" asp-route-id="@role.Id">Excluir</a>
            </td>
        </tr>
    }
</table>
